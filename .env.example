# Where Ollama is reachable FROM THE SERVER that runs the API route.
# Local development:
OLLAMA_BASE_URL=http://localhost:11434
# On Vercel, point this at your secured tunnel instead. Server-side only -
# never prefix it with NEXT_PUBLIC_ or expose it to the browser.

# Default model. qwen3:8b is the best of the two; gemma3:4b is much faster and
# is the realistic choice for Vercel, whose functions stop at 60 seconds.
OLLAMA_MODEL=qwen3:8b
# OLLAMA_MODEL=gemma3:4b

# Optional. Vercel Hobby caps a function at 60s, so 55000 leaves room to fail
# cleanly. Locally you can raise this a lot.
OLLAMA_TIMEOUT_MS=55000
